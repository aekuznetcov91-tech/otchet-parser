@echo off
chcp 65001 > nul
title Автопарсинг, тесты и выгрузка на сайт

echo ==================================================
echo   1. Парсинг выгрузок и обновление данных...
echo ==================================================
python scripts\parser_engine.py
if %errorlevel% neq 0 (
    echo.
    echo [ОШИБКА] Сбой при выполнении парсера!
    pause
    exit /b %errorlevel%
)

echo.
echo ==================================================
echo   2. Запуск тестов, синхронизация и деплой...
echo ==================================================
python deploy_to_cloudflare.py
if %errorlevel% neq 0 (
    echo.
    echo [ОШИБКА] Сбой сборки или деплоя!
    pause
    exit /b %errorlevel%
)

echo.
echo ==================================================
echo   Успешно! Данные обновлены и опубликованы.
echo ==================================================
pause
