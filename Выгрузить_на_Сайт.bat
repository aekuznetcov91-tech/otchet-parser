@echo off
chcp 65001 > nul
title Автопарсинг, тесты и защищенная выгрузка на сайт

echo ==================================================
echo   1. Автоматический парсинг данных...
echo ==================================================
python scripts\parser_engine.py
if %errorlevel% neq 0 (
    echo [ОШИБКА] Сбой парсера данных!
    pause
    exit /b %errorlevel%
)

echo.
echo ==================================================
echo   2. Запуск проверок и выгрузка на сайт...
echo ==================================================
python deploy_to_cloudflare.py
if %errorlevel% neq 0 (
    echo [ОШИБКА] Сбой сборки или деплоя!
    pause
    exit /b %errorlevel%
)

echo.
echo ==================================================
echo   Успешно! Дашборд защищен и обновлен.
echo ==================================================
pause
